{
  "name": "@seatlayer/server",
  "version": "0.5.0",
  "description": "Official Node.js server SDK for SeatLayer inventory, holds, booking references, allocations, and reports. Secret-key only.",
  "license": "MIT",
  "homepage": "https://seatlayer.io/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seatlayer/seatlayer-node.git"
  },
  "bugs": {
    "url": "https://github.com/seatlayer/seatlayer-node/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:package": "publint && attw --pack .",
    "validate": "pnpm typecheck && pnpm test && pnpm build && pnpm lint:package",
    "prepublishOnly": "pnpm validate"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "24.10.1",
    "publint": "0.3.21",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "keywords": [
    "seatlayer",
    "reserved-seating",
    "seating-chart",
    "ticketing",
    "inventory-management",
    "server-sdk",
    "seat-map"
  ],
  "engines": {
    "node": ">=20.19.4"
  },
  "packageManager": "pnpm@11.10.0"
}
